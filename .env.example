# Local development only. Copy to .env (gitignored) and fill in.
#
# Pods do NOT read this file: a RunPod pod gets all six variables from the pod
# config. See the "Starting a pod" section of README.md.

# --- Non-secret settings ---------------------------------------------------
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/Users/<your-email>/kd-gsm8k
HF_HUB_REPO_PREFIX=

# --- Secrets: leave commented out locally ----------------------------------
# Pod only: set these as RunPod secrets. Locally, leave them unset;
# ~/.databrickscfg provides the credentials, and empty values here would
# override it.
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=

# Same reasoning, different credential file: locally this comes from
# ~/.cache/huggingface/token, written by `hf auth login`. An empty HF_TOKEN
# here would override that file.
# HF_TOKEN=
